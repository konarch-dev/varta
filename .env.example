# ==============================================================================
# VARTA — Baat Sabki | Environment Configuration Template
# ==============================================================================
# Copy this file to .env in local development.
# In production, values are injected via Docker Compose or host environment variables.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT_API=3001
PORT_WEB=3000

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://varta_user:varta_secure_password_123@localhost:5432/varta_db?schema=public
POSTGRES_USER=varta_user
POSTGRES_PASSWORD=varta_secure_password_123
POSTGRES_DB=varta_db
POSTGRES_PORT=5432

# Redis Configuration (Caching, BullMQ Queues, WebSocket Adapter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets (Generate with `openssl rand -base64 32`)
JWT_ACCESS_SECRET=varta_dev_access_secret_super_secure_key_change_in_prod_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=varta_dev_refresh_secret_super_secure_key_change_in_prod_32chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=varta_cookie_signing_secret_dev_32chars

# Media Storage Configuration
MEDIA_STORAGE_DRIVER=local
MEDIA_UPLOAD_DIR=./uploads
MEDIA_PUBLIC_URL=http://localhost:3001/uploads
MAX_IMAGE_SIZE_BYTES=5242880       # 5 MB
MAX_VIDEO_SIZE_BYTES=52428800      # 50 MB

# Email Provider Configuration (Mailjet)
MAIL_MAILER=mailjet
MAILJET_APIKEY=your_mailjet_api_key_here
MAILJET_APISECRET=your_mailjet_api_secret_here
MAIL_FROM_ADDRESS=noreply@varta.in
MAIL_FROM_NAME="VARTA — Baat Sabki"
MAILJET_SANDBOX=false
EMAIL_VERIFICATION_REQUIRED=true

# Security & Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Platform Moderation & Grievance Contact
GRIEVANCE_OFFICER_NAME="VARTA Grievance Team"
GRIEVANCE_OFFICER_EMAIL="grievance@varta.local"
