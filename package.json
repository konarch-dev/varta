{
  "name": "varta-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB,WORKER\" -c \"blue,green,magenta\" \"npm run dev -w apps/api\" \"npm run dev -w apps/web\" \"npm run dev -w apps/worker\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/worker",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate -w packages/database",
    "db:migrate": "npm run db:migrate -w packages/database",
    "db:seed": "npm run db:seed -w packages/database",
    "db:seed:users": "npm run db:seed:users -w packages/database",
    "db:seed:posts": "npm run db:seed:posts -w packages/database",
    "db:seed:groups": "npm run db:seed:groups -w packages/database",
    "db:seed:football": "npm run db:seed:football -w packages/database",
    "db:seed:cricket": "npm run db:seed:cricket -w packages/database",
    "db:seed:hockey": "npm run db:seed:hockey -w packages/database",
    "db:seed:basketball": "npm run db:seed:basketball -w packages/database",
    "db:seed:tennis": "npm run db:seed:tennis -w packages/database",
    "db:seed:volleyball": "npm run db:seed:volleyball -w packages/database",
    "db:seed:tabletennis": "npm run db:seed:tabletennis -w packages/database",
    "db:seed:golf": "npm run db:seed:golf -w packages/database",
    "db:seed:entertainment": "npm run db:seed:entertainment -w packages/database",
    "db:seed:vantara": "npm run db:seed:vantara -w packages/database",
    "db:seed:vantara-business": "npm run db:seed:vantara-business -w packages/database",
    "db:seed:vantara-techno": "npm run db:seed:vantara-techno -w packages/database",
    "db:seed:vantara-tour": "npm run db:seed:vantara-tour -w packages/database",
    "db:seed:vantara-taste": "npm run db:seed:vantara-taste -w packages/database",
    "db:seed:vantara-life": "npm run db:seed:vantara-life -w packages/database",
    "db:seed:vantara-health": "npm run db:seed:vantara-health -w packages/database",
    "db:seed:varta-states": "npm run db:seed:varta-states -w packages/database",
    "db:seed:amader-bangla": "npm run db:seed:amader-bangla -w packages/database",
    "db:seed:mana-andhra": "npm run db:seed:mana-andhra -w packages/database",
    "db:seed:arunachal-voices": "npm run db:seed:arunachal-voices -w packages/database",
    "db:seed:axom-xomaj": "npm run db:seed:axom-xomaj -w packages/database",
    "db:seed:aapnu-gujarat": "npm run db:seed:aapnu-gujarat -w packages/database",
    "db:seed:apna-bihar": "npm run db:seed:apna-bihar -w packages/database",
    "db:seed:mor-chhattisgarh": "npm run db:seed:mor-chhattisgarh -w packages/database",
    "db:seed:apna-haryana": "npm run db:seed:apna-haryana -w packages/database",
    "db:seed:apna-up": "npm run db:seed:apna-up -w packages/database",
    "db:seed:naga-heritage": "npm run db:seed:naga-heritage -w packages/database",
    "db:seed:tripura-connect": "npm run db:seed:tripura-connect -w packages/database",
    "db:clean:tripura-connect": "npm run db:clean:tripura-connect -w packages/database",
    "db:clean:naga-heritage": "npm run db:clean:naga-heritage -w packages/database",
    "db:seed:johar-jharkhand": "npm run db:seed:johar-jharkhand -w packages/database",
    "db:clean:johar-jharkhand": "npm run db:clean:johar-jharkhand -w packages/database",
    "db:clean:mizo-hnam": "npm run db:clean:mizo-hnam -w packages/database",
    "db:seed:mizo-hnam": "npm run db:seed:mizo-hnam -w packages/database",
    "db:seed:devbhoomi-uttarakhand": "npm run db:seed:devbhoomi-uttarakhand -w packages/database",
    "db:clean:devbhoomi-uttarakhand": "npm run db:clean:devbhoomi-uttarakhand -w packages/database",
    "db:seed:aapla-maharashtra": "npm run db:seed:aapla-maharashtra -w packages/database",
    "db:clean:aapla-maharashtra": "npm run db:clean:aapla-maharashtra -w packages/database",
    "db:clean:sadda-punjab": "npm run db:clean:sadda-punjab -w packages/database",
    "db:seed:sadda-punjab": "npm run db:seed:sadda-punjab -w packages/database",
    "db:clean:namma-karnataka": "npm run db:clean:namma-karnataka -w packages/database",
    "db:seed:namma-karnataka": "npm run db:seed:namma-karnataka -w packages/database",
    "db:clean:sintel-video": "npm run db:clean:sintel-video -w packages/database",
    "db:clean:stadium-image": "npm run db:clean:stadium-image -w packages/database",
    "db:clean:nature-images": "npm run db:clean:nature-images -w packages/database",
    "db:clean:unsplash-images": "npm run db:clean:unsplash-images -w packages/database",
    "db:studio": "npm run db:studio -w packages/database",
    "db:backup": "cmd /c \"docker exec -i varta-dev-postgres pg_dump -U varta_user -d varta_db --clean --if-exists > database_backup\\varta_backup.sql\"",
    "db:restore": "cmd /c \"docker exec -i varta-dev-postgres psql -U varta_user -d varta_db < database_backup\\varta_backup.sql\"",
    "docker:dev:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
